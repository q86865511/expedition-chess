{
  "dirs": [
    "res://tests/unit",
    "res://tests/integration"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "double_strategy": "SCRIPT_ONLY",
  "failure_error_types": [
    "engine",
    "gut",
    "push_error"
  ],
  "junit_xml_file": "",
  "junit_xml_timestamp": false,
  "log_level": 1,
  "ignore_pause": true,
  "should_exit": false,
  "should_exit_on_success": false
}

