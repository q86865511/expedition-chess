{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-visual-inventory.schema.json",
  "title": "Production Environment Visual Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice", "status", "visuals"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "slice": { "const": "ui-art-refresh-c-2" },
    "status": { "const": "adopted" },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visual" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_id",
        "kind",
        "status",
        "path",
        "sha256",
        "width",
        "height",
        "source_path",
        "source_sha256"
      ],
      "properties": {
        "visual_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["environment", "key_art"] },
        "status": { "const": "adopted" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_inventory": { "type": "string", "minLength": 1 },
        "provenance": { "type": "string", "minLength": 1 }
      }
    }
  }
}
