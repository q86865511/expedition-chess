[sub_resource type="Resource" id="Resource_y3qsm"]
script = ExtResource("2_qhm6r")
# TUNE: max_mana +10 依附錄 B 映射為開戰全隊 mana +10。
amount = 10
target = &"all_allies"

[resource]
script = ExtResource("5_dehps")
trigger = &"battle_start"
battle_operations = Array[ExtResource("1_iomio")]([SubResource("Resource_y3qsm")])
stacking = &"replace"
duration_ticks = 1800
schema_version = 2
description_key = &"loc.effect_trait_role_mystic_description"
id = &"effect.trait_role_mystic"
display_name_key = &"loc.effect_trait_role_mystic"
